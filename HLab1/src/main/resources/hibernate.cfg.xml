<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration SYSTEM
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
        <!-- 1. Database Connection Settings -->
        <property name="connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="connection.url">jdbc:mysql://localhost:3306/smsdb</property>
        <property name="connection.username">root</property>
        <property name="connection.password">Aadi@1922</property>

        <!-- 2. Database Dialect -->
        <property name="dialect">org.hibernate.dialect.MySQLDialect</property>

        <!-- 3. Session Management & Threading -->
        <property name="current_session_context_class">thread</property>

        <!-- 4. Cache & Connection Pool Settings (Optional) -->
        <property name="connection.pool_size">5</property>

        <!-- 5. Debugging & Formatting SQL Commands -->
        <property name="show_sql">true</property>
        <property name="format_sql">false</property>

        <!-- 6. Automatic Schema Generation Strategy -->
        <!-- Options: update, create, create-drop, validate -->
        <property name="hbm2ddl.auto">update</property>

        <!-- 7. Register Your Annotated Entity Classes -->
        <mapping class="com.hib.test.entity.Student" />



    </session-factory>
</hibernate-configuration>